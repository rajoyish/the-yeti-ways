{
  "manifest_version": 3,
  "name": "Flow Storyboard Downloader",
  "version": "1.0.0",
  "description": "Creates a Google Flow project and collections from a storyboard, then downloads each collection's videos at 1080p, named after the storyboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Flow Storyboard Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["https://labs.google/*", "https://flow.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*", "https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
