{
  "manifest_version": 3,
  "name": "Flow Music Score Runner",
  "version": "1.0.0",
  "description": "Generates a film's instrumental music and sound-effects bed in Google Flow Music, movement by movement, and joins it into one WAV exactly as long as the voice track, for Adobe Premiere Pro.",
  "permissions": ["sidePanel", "downloads", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["https://www.flowmusic.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Flow Music Score Runner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.flowmusic.app/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.flowmusic.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
