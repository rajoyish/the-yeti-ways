{
  "manifest_version": 3,
  "name": "Flow Character Linker",
  "version": "1.1.0",
  "description": "Turns plain @Name text in the Google Flow prompt box into linked Character chips.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Link @ Characters in the Flow prompt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "link-characters": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Link @ Characters in the Flow prompt"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
