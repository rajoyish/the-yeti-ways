{
  "manifest_version": 3,
  "name": "AI Studio Voice Runner",
  "version": "1.2.0",
  "description": "Voices a whole Yeti story (stories/*.md) or every line of a speech guide (speech-prompts/*-tts.md) in Google AI Studio with Gemini 3.8 Flash TTS, saves the takes, and joins or stitches them into story and video speech tracks.",
  "permissions": ["sidePanel", "downloads", "storage", "unlimitedStorage", "tabs", "scripting"],
  "host_permissions": ["https://aistudio.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open AI Studio Voice Runner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
